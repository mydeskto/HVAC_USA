# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nplt20league
DATABASE_SSL=false

# HTTP server
NODE_ENV=development
PORT=3001
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Admin session (maximum supported lifetime is 24 hours)
SESSION_COOKIE_NAME=npl_admin_session
SESSION_TTL_HOURS=24
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Uploaded media storage. UPLOAD_DIR is resolved from the backend process cwd.
UPLOAD_DIR=./uploads
PUBLIC_MEDIA_BASE_URL=/uploads

# Idempotent superadmin seed. If SUPERADMIN_PASSWORD is omitted, the seed
# command generates a strong random password and prints it once.
SUPERADMIN_NAME=NPL Super Admin
SUPERADMIN_EMAIL=admin@nplt20league.local
SUPERADMIN_PASSWORD=ugfc456789.uy6tr56

# Optional live-score provider secret (never expose this as NEXT_PUBLIC_*).
SPORTBEX_API_KEY=
